{
  "name": "edu-pay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite",
    "build": "vite build",
    "build:desktop": "vite build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.edupay.app",
    "productName": "EduPay",
    "icon": "public/icon.png",
